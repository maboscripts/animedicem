end

-- =====================
-- AUTO ROLL LOOP
-- =====================
task.spawn(function()
    loadRemotes()
    task.wait(2)

    while true do
        task.wait(CONFIG.RollDelay)
        if CONFIG.AutoRoll then
            if Remotes.Roll then
                safeCall(Remotes.Roll)
                rolls += 1
                RollLabel.Text = "Rolls: " .. rolls
                setStatus("Rolling via remote ✓")
            else
                -- Fallback: click in-game button
                local btn = findButton({"roll","spin","gacha","draw","dice"})
                if btn then
                    btn:SimulateClick()
                    rolls += 1
                    RollLabel.Text = "Rolls: " .. rolls
                    setStatus("Rolling via button ✓")
                else
                    setStatus("⚠ Roll button not found")
                    loadRemotes()
                    task.wait(1)
                end
            end
        end
    end
end)

